{
  "permissions": {
    "allow": [
      "Bash(python3 -m http.server:*)",
      "Bash(node --check:*)",
      "Bash(curl -s http://localhost:8000/*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(scripts/bump-sw.sh)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/scripts/check-sw-bump.sh"
          }
        ]
      }
    ]
  }
}
